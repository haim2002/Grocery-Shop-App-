<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_display_adapter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">


    <TextView
        android:id="@+id/product_display"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@android:drawable/editbox_background_normal"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/quantity_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_middle_x"
        app:layout_constraintTop_toTopOf="@+id/quantity_display" />



    <TextView
        android:id="@+id/quantity_display"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@android:drawable/editbox_background_normal"
        android:minWidth="30dp"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_middle_x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/x"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/quantity_display"
        app:layout_constraintStart_toEndOf="@+id/quantity_display"
        app:layout_constraintTop_toTopOf="@+id/quantity_display" />



</androidx.constraintlayout.widget.ConstraintLayout>